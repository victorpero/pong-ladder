APP_PORT=3000

POSTGRES_DB=pong_ladder
POSTGRES_USER=pong
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

DATABASE_URL="postgresql://pong:replace-with-a-strong-database-password@localhost:5432/pong_ladder?schema=public"
NEXT_PUBLIC_APP_NAME="Pong Ladder"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ORGANIZATION_ACCESS_CODE_SECRET="replace-with-a-separate-32-character-random-secret"
SESSION_COOKIE_SECURE=false
APP_ENABLE_HTTPS_HEADERS=false

SEED_ADMIN_PASSWORD="replace-admin-seed-password"
SEED_USER_PASSWORD="replace-user-seed-password"
ORGANIZATION_CREATION_ENABLED="false"
ORGANIZATION_CREATOR_EMAILS=""
# Optional seed-only code. Leave blank and generate one from owner settings after seeding.
POLISEN_ACCESS_CODE=
