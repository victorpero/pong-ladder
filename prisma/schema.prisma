generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeStatus {
  Pending
  Accepted
  Declined
  Completed
  Forfeit
}

enum OrganizationType {
  WORKPLACE
  SPORTS_CLUB
  SCHOOL
  FRIENDS
  OTHER
}

enum MembershipRole {
  OWNER
  ADMIN
  PLAYER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Organization {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  type        OrganizationType
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships Membership[]
  seasons     Season[]
  teams       Team[]

  @@index([name])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole   @default(PLAYER)
  status         MembershipStatus @default(PENDING)
  displayName    String?
  teamId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  seasonPlayers  SeasonPlayer[]

  @@unique([userId, organizationId])
  @@unique([id, userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
  @@index([teamId])
}

model User {
  id              String         @id @default(cuid())
  username        String         @unique
  fullName        String
  email           String         @unique
  passwordHash    String
  isAdmin         Boolean        @default(false)
  isApproved      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  seasonPlayers   SeasonPlayer[]
  wonMatches      Match[]        @relation("WinnerMatches")
  lostMatches     Match[]        @relation("LoserMatches")
  challengesMade  Challenge[]    @relation("Challenger")
  challengesTaken Challenge[]    @relation("Challenged")
  memberships     Membership[]

  @@index([username])
  @@index([fullName])
  @@index([isApproved])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        Membership[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model Season {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  year           Int
  seasonNumber   Int
  startsAt       DateTime
  endsAt         DateTime?
  isActive       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  players        SeasonPlayer[]
  matches        Match[]
  challenges     Challenge[]

  @@unique([id, organizationId])
  @@unique([organizationId, year, seasonNumber])
  @@index([organizationId, isActive])
  @@index([organizationId, year])
}

model SeasonPlayer {
  id             String     @id @default(cuid())
  organizationId String
  seasonId       String
  membershipId   String
  userId         String
  points         Int        @default(0)
  currentRank    Int
  joinedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  season         Season     @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership     Membership @relation(fields: [membershipId, userId, organizationId], references: [id, userId, organizationId], onDelete: Restrict)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@unique([seasonId, currentRank])
  @@index([organizationId, seasonId, points])
  @@index([organizationId, userId])
  @@index([membershipId])
}

model Match {
  id                 String     @id @default(cuid())
  organizationId     String
  seasonId           String
  winnerId           String
  loserId            String
  winnerSets         Int
  loserSets          Int
  winnerPointsBefore Int
  loserPointsBefore  Int
  winnerPointsAfter  Int
  loserPointsAfter   Int
  playedAt           DateTime   @default(now())
  challengeId        String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  season             Season     @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  winner             User       @relation("WinnerMatches", fields: [winnerId], references: [id])
  loser              User       @relation("LoserMatches", fields: [loserId], references: [id])
  challenge          Challenge? @relation(fields: [challengeId], references: [id])

  @@index([organizationId, seasonId, playedAt])
  @@index([winnerId])
  @@index([loserId])
}

model Challenge {
  id             String          @id @default(cuid())
  organizationId String
  seasonId       String
  challengerId   String
  challengedId   String
  status         ChallengeStatus @default(Pending)
  declinedCount  Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  season         Season          @relation(fields: [seasonId, organizationId], references: [id, organizationId], onDelete: Cascade)
  challenger     User            @relation("Challenger", fields: [challengerId], references: [id])
  challenged     User            @relation("Challenged", fields: [challengedId], references: [id])
  match          Match?

  @@index([organizationId, seasonId, status])
  @@index([organizationId, seasonId, challengerId, challengedId, status])
  @@index([challengerId])
  @@index([challengedId])
}
